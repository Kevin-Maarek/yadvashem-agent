# Copy to .env. Edit .env, then run: docker compose up -d --build
# Process environment overrides .env for direct Python runs.
# Docker loads this file through env_file; use compose run -e KEY=value for overrides.

# Web and database services
WEB_PORT=3030
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin-local
POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=archive-local
PGHOST=localhost
PGPORT=5432
# Compose overrides PGHOST to postgres and maps POSTGRES_* to PG*.

# Generation (chat + vision): ollama | openai | openrouter
AI_PROVIDER=ollama
# Independent embedding provider; keep ollama to retain the existing vector index.
EMBEDDING_PROVIDER=ollama

# Ollama defaults (Docker Desktop on Windows)
OLLAMA_URL=http://host.docker.internal:11434
VISION_MODEL=qwen3.8:latest
CHAT_MODEL=qwen3.8:latest
EMBEDDING_MODEL=qwen3-embedding:latest
EMBEDDING_DIMENSIONS=4096
OLLAMA_TIMEOUT_SECONDS=150
VISION_OUTPUT_TOKENS=5200

# API credentials are server-side only. Fill only keys for providers you select.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
API_TIMEOUT_SECONDS=150
# Bump when an API model alias changes to invalidate cached API outputs.
API_MODEL_REVISION=1

# Ingestion and search
SOURCE_DELAY_SECONDS=1
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
SEARCH_LIMIT=5
SEARCH_THRESHOLD=0.85

# Example: OpenAI chat + vision, retaining Ollama embeddings.
# Replace the active values above; do not leave duplicate assignments uncommented.
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# CHAT_MODEL=gpt-4.1-mini
# VISION_MODEL=gpt-4.1-mini
# EMBEDDING_PROVIDER=ollama

# Example: OpenRouter chat + vision, retaining Ollama embeddings.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# CHAT_MODEL=openai/gpt-4.1-mini
# VISION_MODEL=openai/gpt-4.1-mini
# EMBEDDING_PROVIDER=ollama

# Optional API embeddings (requires a compatible database schema and reindexing).
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# For OpenRouter use EMBEDDING_PROVIDER=openrouter, OPENROUTER_API_KEY,
# and EMBEDDING_MODEL=openai/text-embedding-3-small.
# API embedding models must support the dimensions parameter.
# For Python running directly on Windows, use OLLAMA_URL=http://localhost:11434.
